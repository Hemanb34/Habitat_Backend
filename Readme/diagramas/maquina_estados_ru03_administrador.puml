@startuml
title Máquina de Estados UML 2.5 — Épica RU-03: Gestión del Ecosistema y Modelos (Flujo de Trabajo del Administrador)
top to bottom direction
scale max 2800 width
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 10
skinparam nodesep 22
skinparam ranksep 28
skinparam padding 5
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam ArrowColor #263238
skinparam ArrowFontColor #1A237E
skinparam ArrowFontSize 11

skinparam state {
  BackgroundColor #F8FAFC
  BorderColor #334155
  BorderThickness 1.5
  FontName "Segoe UI"
  FontSize 12
  FontStyle bold
  AttributeFontName "Consolas"
  AttributeFontSize 11
  BackgroundColor<<Auth>> #E3F2FD
  BorderColor<<Auth>> #1565C0
  BackgroundColor<<Lock>> #FFEBEE
  BorderColor<<Lock>> #C62828
  BackgroundColor<<Dashboard>> #FFF8E1
  BorderColor<<Dashboard>> #F57F17
  BackgroundColor<<Crawler>> #E8F5E9
  BorderColor<<Crawler>> #2E7D32
  BackgroundColor<<ML>> #F3E5F5
  BorderColor<<ML>> #6A1B9A
  BackgroundColor<<Success>> #E0F2F1
  BorderColor<<Success>> #00695C
}

[*] -down-> S01_SinAutenticar : T-01: accederPanelAdmin()

state "Fase 1: Seguridad y Autenticación de Administrador (RF-07, RNF-01, RN-05 — MVP F7)" as FaseAuth {
  state "S01: SinAutenticar" as S01_SinAutenticar <<Auth>>
  S01_SinAutenticar : entry / renderizarFormularioLoginAdmin()
  S01_SinAutenticar : do / esperarCredencialesExclusivas()

  state "S02: ValidandoCredenciales" as S02_ValidandoCredenciales <<Auth>>
  S02_ValidandoCredenciales : entry / AutenticacionControl.autenticar_admin(user, pass)
  S02_ValidandoCredenciales : do / consultarAdmin(BD), verificar esta_bloqueado()\n     y verify_password(Bcrypt)

  state c_auth <<choice>>

  state "S03: IntentoFallidoRegistrado" as S03_IntentoFallido <<Auth>>
  S03_IntentoFallido : entry / admin.registrar_intento_fallido_rn05()\n        & guardar(admin)
  S03_IntentoFallido : do / auditar("warn" RNF-09) & retornar HTTP 401\n     (intentos_restantes = 3 - intentos_fallidos)

  state "S04: AccesoBloqueado30Min (RN-05)" as S04_Bloqueado <<Lock>>
  S04_Bloqueado : entry / bloqueado_hasta = ahora + 30 min;\n        auditarBloqueo("error" RNF-09)
  S04_Bloqueado : do / mantenerInhabilitacionTemporal(30 min)
  S04_Bloqueado : T-06 (interna): enviarLogin() [ahora < bloqueado_hasta]\n     / auditar("error"); rechazarHTTP423(min_restantes)
  S04_Bloqueado : exit / admin.resetear_intentos() & limpiar bloqueado_hasta

  S01_SinAutenticar -down-> S02_ValidandoCredenciales : T-02: enviarLogin(user, pass)\n[user != "" && pass != ""]
  S02_ValidandoCredenciales -down-> c_auth : evaluarCredenciales()

  c_auth -up-> S01_SinAutenticar : T-03a: [!usuarioExiste]\n/ auditar("warn"); HTTP 401
  c_auth -left-> S03_IntentoFallido : T-03b: [usuarioExiste && !esta_bloqueado() &&\n!verify_password() && intentos_fallidos < 2]\n/ incrementarFallos()
  S03_IntentoFallido -up-> S02_ValidandoCredenciales : T-04: reintentarLogin(user, pass)

  c_auth -right-> S04_Bloqueado : T-05: [esta_bloqueado() || (usuarioExiste &&\n!verify_password() && intentos_fallidos + 1 == 3)]\n/ bloquearCuenta30Min()
  S04_Bloqueado -up-> S01_SinAutenticar : T-07: after(30 min)\n[ahora >= bloqueado_hasta]\n/ rehabilitarAcceso()
}

c_auth -down-> S05_PanelControlActivo : T-08: [usuarioExiste && !esta_bloqueado() && verify_password()] / resetear_intentos(), emitirTokenJWT() & auditar("ok")

state "Superestado S05: PanelControlAdminActivo (Gobernanza del Ecosistema y Modelos — RU-03)" as S05_PanelControlActivo {

  [*] -down-> S06_SupervisandoDashboard

  state "S06: SupervisandoDashboard (RF-11, RNF-09)" as S06_SupervisandoDashboard <<Dashboard>>
  S06_SupervisandoDashboard : entry / AdminOrchestratorControl.obtener_estado_dashboard()
  S06_SupervisandoDashboard : do / visualizarGraficasMAPE(), historicoExtracciones()\n     y tablaLogAuditoria()

  state "Fase 2: Orquestación Asíncrona de Crawlers (RF-08, RNF-03, RNF-07, RN-06 — MVP F1)" as FaseCrawlers {
    state "S07: InstanciandoSpidersFactory (RNF-07)" as S07_Factory <<Crawler>>
    S07_Factory : entry / CrawlerFactory.create_crawler(portales)
    S07_Factory : do / inyectar PropertyDataAdapter y semáforos

    state fork_crawl <<fork>>
    state join_crawl <<join>>

    state "S08: ExtrayendoEnParalelo (asyncio.gather — RF-08)" as S08_Extrayendo {
      state "S08a: WorkerFincaRaiz" as S08a <<Crawler>>
      S08a : entry / estado = "running"
      S08a : do / extraerPublicaciones()

      state "S08b: WorkerMetrocuadrado" as S08b <<Crawler>>
      S08b : entry / estado = "running"
      S08b : do / extraerPublicaciones()

      state "S08c: WorkerCienCuadras" as S08c <<Crawler>>
      S08c : entry / estado = "running"
      S08c : do / extraerPublicaciones()
    }

    state "S09: NormalizandoYFiltrandoRN06" as S09_FiltrandoRN06 <<Crawler>>
    S09_FiltrandoRN06 : entry / PropertyDataAdapter.adapt_many(raw_payloads)
    S09_FiltrandoRN06 : do / descartarSinUrlOrigen(RN-06) & deduplicarPorUrlOrigen()

    state c_crawl <<choice>>

    state "S10: ExtraccionCompletada (RNF-09)" as S10_CrawlExito <<Success>>
    S10_CrawlExito : entry / predecir_lote() IA &\n        upsert_lote_propiedades()
    S10_CrawlExito : do / Portal.estado = "idle";\n     auditar CrawlerJob("SUCCESS") & Log("ok")

    state "S11: ExtraccionConError (RNF-09)" as S11_CrawlError <<Lock>>
    S11_CrawlError : entry / Portal.ultimo_estado = "error"
    S11_CrawlError : do / registrar CrawlerJob("FAILED")\n     y LogAuditoria("warn" / "error")

    S07_Factory -down-> fork_crawl : T-10: spidersListos() [portales >= 1]
    fork_crawl -down-> S08a
    fork_crawl -down-> S08b
    fork_crawl -down-> S08c
    S08a -down-> join_crawl
    S08b -down-> join_crawl
    S08c -down-> join_crawl
    join_crawl -down-> S09_FiltrandoRN06 : T-11: payloadsRecibidos()\n/ consolidarPayloads()
    S09_FiltrandoRN06 -down-> c_crawl : evaluarValidosRN06()

    c_crawl -down-> S10_CrawlExito : T-12: [registros_validos_rn06 > 0]\n/ persistirCatalogoYAuditar()
    c_crawl -down-> S11_CrawlError : T-13: [registros_validos_rn06 == 0 || falloRed]\n/ registrarErrorExtraccion()
  }

  S06_SupervisandoDashboard -down-> S07_Factory : T-09a: clicEjecutarCrawlers() [Manual RF-08]\nT-09b: after(24 horas) [Cronograma RNF-03]
  S10_CrawlExito -up-> S06_SupervisandoDashboard : T-14a: actualizarMetricasExtraccion() [RF-11]
  S11_CrawlError -up-> S06_SupervisandoDashboard : T-14b: reportarAlertaEnDashboard() [RF-11]

  state fork_ml <<fork>>
  S06_SupervisandoDashboard -down-> fork_ml : T-15: accionarReentrenamiento() [RF-09, RF-10]\n/ despacharEnSegundoPlano(HTTP 202)

  state "Fase 3: Preprocesamiento y Reentrenamiento en Segundo Plano (RF-09, RF-10, RN-01, RN-02, RNF-08 — MVP F2 y F3)" as FaseML {
    state "Rama A: Continuidad (RNF-08)" as RegionDisponibilidad {
      state "S12A: ServicioConsultasDisponible" as S12A_ServicioActivo <<Success>>
      S12A_ServicioActivo : entry / mantenerArtefactoVigenteEnRAM()
      S12A_ServicioActivo : do / atenderConsultasSinBloqueo()
    }

    state "Rama B: Pipeline ETL y Template Method ML (RF-09, RF-10, RN-02)" as RegionEntrenamiento {
      state "S12B: LimpiandoYPreparandoDatos (RF-09, RN-06)" as S12B_Limpiando <<ML>>
      S12B_Limpiando : entry / PreprocesamientoControl.ejecutar_limpieza_y_preparacion()
      S12B_Limpiando : do / aplicar RN-06 (url_origen), sjoinGeoJSON(),\n     rescatarGPSFuzzy() y filtrarIQR()

      state "S13: ParticionandoYEscalandoSinFuga (RF-09, RN-02)" as S13_SinFuga <<ML>>
      S13_SinFuga : entry / _particionar_80_20() -> 80% Train / 20% Validacion
      S13_SinFuga : do / fit(StandardScaler, OneHotEncoder, TargetEncoder,\n     SpatialKNN) SOLO en 80% Train
      S13_SinFuga : exit / transform(X_val) sin recalcular &\n       emitirCheckVerdeUI()

      state "S14: EntrenandoYEvaluandoModelo (RF-10, RNF-02)" as S14_Entrenando <<ML>>
      S14_Entrenando : entry / BaseModelTrainingPipeline.ejecutar_pipeline_completo()
      S14_Entrenando : do / entrenar VotingRegressor(Poblado & OtrasComunas)\n     y evaluar MAPE sobre 20% Validacion

      S12B_Limpiando -down-> S13_SinFuga : T-16: limpiezaCompletada() [registros_limpios > 0]
      S13_SinFuga -down-> S14_Entrenando : T-17: preprocesamientoSinFugaListo() [RN-02 cumplida]
    }
  }

  fork_ml -down-> S12A_ServicioActivo
  fork_ml -down-> S12B_Limpiando

  state join_ml <<join>>
  S12A_ServicioActivo -down-> join_ml
  S14_Entrenando -down-> join_ml

  state c_rn01 <<choice>>
  join_ml -down-> c_rn01 : evaluarCompuertaCalidadRN01()

  state "S15: ModeloPromovidoAProduccion (Cumple RN-01)" as S15_Promovido <<Success>>
  S15_Promovido : entry / guardar_artefacto(.joblib) &\n        recargar_modelo_en_caliente()
  S15_Promovido : do / registrar ModeloPrediccion(en_produccion=True)\n     y LogAuditoria("ok" RNF-09)

  state "S16: DespliegueAbortadoPorMAPE (Rechazo RN-01)" as S16_Abortado <<Lock>>
  S16_Abortado : entry / abortarPromocion() &\n        conservarModeloAnteriorEnProduccion()
  S16_Abortado : do / registrar ModeloPrediccion(en_produccion=False),\n     LogAuditoria("error") y notificarAdmin()

  c_rn01 -down-> S15_Promovido : T-18a: [MAPE_Poblado <= 16% &&\nMAPE_Comunas <= 16% (RN-01, RNF-02)]\n/ promoverModeloAProduccion()
  c_rn01 -down-> S16_Abortado : T-18b: [MAPE_Poblado > 16% ||\nMAPE_Comunas > 16% (RN-01, RNF-02)]\n/ abortarDespliegueYNotificar()

  S15_Promovido -up-> S06_SupervisandoDashboard : T-19a: actualizarSerieHistoricaMAPE() [RF-11]
  S16_Abortado -up-> S06_SupervisandoDashboard : T-19b: mostrarNotificacionFalloMAPE() [RF-11]
}

state "S17: SesionAdministrativaCerrada" as S17_SesionCerrada <<Auth>>
S17_SesionCerrada : entry / eliminarTokenCliente() & registrarCierreSesion()

S05_PanelControlActivo -down-> S17_SesionCerrada : T-20: cerrarSesionAdmin() | expiracionTokenJWT() / invalidarSesionActiva()
S17_SesionCerrada -down-> [*]
@enduml
